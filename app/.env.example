# ── Database (Neon) ──
# Pooled connection string (…-pooler…) for the app; direct (non-pooled) for migrations
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/mugcake?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/mugcake?sslmode=require"

# ── Auth.js v5 ──
AUTH_SECRET=""                    # openssl rand -base64 32
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
ADMIN_EMAILS="amitha_gurre@pg27.mesaschool.co"   # comma-separated allowlist

# ── App ──
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
IP_HASH_SALT=""                   # random string
FEATURE_SHOP="false"
SURVEY_MIN_SECONDS="8"              # reject survey submits faster than this after page load

# ── Jobs ──
CRON_SECRET=""                    # Vercel sends this as Bearer token to /api/cron/*
SCRAPER_CONTACT_EMAIL="amitha_gurre@pg27.mesaschool.co"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""                # set to a current Claude model id from docs.claude.com
REPORT_EMAIL="amitha_gurre@pg27.mesaschool.co"
REPORT_SKIP_IF_QUIET="false"

# ── Email (Resend) ──
RESEND_API_KEY=""
EMAIL_FROM="Mug cake <hello@yourdomain.in>"

# ── Files (Vercel Blob, for test-bake photos) ──
BLOB_READ_WRITE_TOKEN=""

# ── Payments (phase 5, keep empty until FSSAI licence + lab report) ──
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
